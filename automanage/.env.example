# Salin file ini jadi ".env" lalu isi sendiri. File .env tidak ikut ke git.
# Cuma pakai satu broker? Bagian broker lain boleh dikosongkan.

# --- Bot MT5 + kotak masuk (dipakai bot MT5 dan bot Bybit) ---
# Token bot MT5 dari @BotFather
TG_BOT_TOKEN=
# ID channel kotak masuk (angka negatif, -100...) dan ID akun Telegram kamu.
# ID channel bisa disimpan lewat MENU.bat > Utilitas > Ganti channel kotak masuk sinyal.
# Login Reader diperlukan untuk mendeteksi channel.
TG_INBOX_CHANNEL_ID=
TG_ADMIN_USER_ID=

# --- MT5 ---
# Boleh dikosongkan kalau MT5 desktop sudah dibuka dan login sendiri (disarankan).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# --- Pembaca sinyal (program kedua) ---
# API ID dan API hash dari https://my.telegram.org (login pakai akun Telegram-mu,
# menu "API development tools"). Ini akses ke akunmu: jangan dibagikan ke siapa pun.
TG_API_ID=
TG_API_HASH=
# Mata pembaca = Claude Code (ikut langganan Pro). Tidak perlu key di sini:
# cukup login sekali di terminal dengan perintah:  claude auth login

# --- Eksekutor Bybit (USDT Perpetual) ---
# Akun Bybit (API key per akun, boleh lebih dari satu) TIDAK diisi di sini, tapi lewat
# MENU > Setelan universal > Bybit > Akun Bybit, atau saat menambah sumber Bybit.
# Tersimpan di akun-bybit.env (di samping file ini, tidak ikut git).
# Izin API key: centang hanya Contract (Orders + Positions). JANGAN centang Withdraw.
# Akun Bybit wajib CROSS margin dan mode posisi one-way (bot menolak jalan kalau tidak).
# Token bot Telegram KEDUA khusus eksekutor Bybit (buat lagi di @BotFather), lalu
# jadikan bot itu admin di channel kotak masuk yang sama. ID channel dan ID kamu
# memakai TG_INBOX_CHANNEL_ID dan TG_ADMIN_USER_ID di atas.
BYBIT_TG_BOT_TOKEN=
# Simbol awal di menu "Tes Bybit.bat" (bisa diganti dari menu).
BYBIT_SIMBOL_TES=BTCUSDT

# --- Bot Pengawas (opsional) ---
# Token BotFather khusus Pengawas. Chat pribadi memakai TG_ADMIN_USER_ID di atas.
SUPERVISOR_TG_BOT_TOKEN=
